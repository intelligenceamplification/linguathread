# Optional: connect a Neon or Vercel Postgres database after applying
# drizzle/0004_private_learner_identity.sql. Server-issued installation sessions
# then isolate private learner data; cross-device recovery additionally requires
# a verified identity provider.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional override for a private or staging curriculum registry.
CURRICULUM_MANIFEST_URL=https://example.com/linguathread/curriculum/manifest.json
